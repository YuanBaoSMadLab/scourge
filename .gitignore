build/
build-rel/
bin/
release/
dev_feedback/
.workbuddy/
.trae/

# CMake configure 过程泄漏的 tablegen 生成头（非仓库源码）
include/mlir/

设计.md
AGENTS.md
agents.md

# AI 助手本地配置与规则文件（一律不入库）
CLAUDE.md
GEMINI.md
.cursorrules
.cursor/
.windsurf/
.aider*
.codeium/
.serena/

# 文档治理：仅 README 与 docs/ 语言手册入库，其余文档本地留存
/THIRD_PARTY_NOTICES.md
firmware/**/REVIEW.md

*.exe
*.obj
*.o
*.lib
*.dll
*.bin
*.elf
*.log
*.sgbc
*.sgi
*.mlir
*.ll
*.buildcap

# demos 内 AOT 构建中间产物（与 verify/stdlib 的 _rt.c 同理，产物不入库）
demos/*/main_rt.c
# demos 运行时落盘的报告/摘要产物（重跑即再生，不入库；out/ 内 exe 已被 *.exe 覆盖）
demos/*/metrics-report.md
demos/*/sales-report.md
demos/*/sales-summary.json

# 探针临时输出与打包产物（重跑/重打包即再生，不入库）
*_tmp.txt
*.zip

# examples 就地运行产物与第三方合并源：.sg/.bind/.hpp/.ld 源码入库；
# sqlite3.c/h 为第三方 amalgamation（体量大、有上游），不入库
examples/sget/.d.*
examples/sget/.sq.*
examples/sget/.v.*
examples/sget/sget.lock.json
examples/**/sqlite3.c
examples/**/sqlite3.h

# 外部工具链与第三方依赖源（本地资产，不入库）
toolchain/
vendor/

# 本地工作副本资产（dev_feedback 引用素材；打包与库管均排除）
_gpl/

# AOT obj 增量缓存目录（设计文档 5.2；产物不入库）
*.sgbuild/

# bootstrap 引导解压的 LLVM/MLIR 库包（一键构建的中间产物）
.deps/

# Inno 安装包组装暂存目录（pack.ps1/git archive 现场生成，产物不入库）
packaging/staging/

# firmware 嵌入式构建产物（build.sh 现场生成，不入库）
firmware/**/*.elf
firmware/**/*.bin
firmware/**/*.map
firmware/**/*.log

# verify/ 验证源级资产入库：探针 .sg、脚本 .ps1、驱动探针 .c/.cu、
# kernel 源 .ptx 本就不被忽略；kernel 源 .ll 需反白名单（上方全局规则）。
# 运行产物一律不得写入 verify/（脚本产物统一落 build-rel/verify）。
!verify/**/*.ll
# verify/stdlib 对拍脚本的就地运行产物（重新忽略，覆盖上方 .ll 反白名单）
verify/stdlib/_*
verify/stdlib/*_aot.ll
verify/stdlib/*_rt.c

# verify 探针就地运行/对拍产物（各脚本临时输出）
*.out
verify/types/_*
