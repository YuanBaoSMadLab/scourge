# math_utils.sg — 演示库模块：@pure 函数 + 契约 + 张量运算
# ============================================================================

SCALE: float = 2.0

@pure
def clamp(x: int, lo: int, hi: int) -> int:
    """将 x 限制在 [lo, hi] 区间。
    requires: lo <= hi
    """
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

@pure
def scale2d(m: Tensor[float, (2, 2)], k: float) -> Tensor[float, (2, 2)]:
    """2x2 矩阵逐元素缩放。"""
    return m * k

def matmul2d(a: Tensor[float, (2, 2)], b: Tensor[float, (2, 2)]) -> Tensor[float, (2, 2)]:
    """2x2 矩阵乘（@ 算子）。"""
    return a @ b
