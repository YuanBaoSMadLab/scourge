# main.sg — 02 完整博客站 · 装配入口
# 架构：主线程 accept/read/路由分发；后台线程经 channel 异步聚合计数——
# SYNC 消息做应答栅栏（读视图前对齐，保证双模输出确定），QUIT 哨兵 + join 收尾。
# 职责边界：本文件持有全部可变状态（posts/views/两条 channel）与线程编排，
# 呈现与 JSON 构造委托 views_html / json_api / stats_hub（纯函数模块）。
# 路由：GET /（前端 fetch 动态渲染列表）、/style.css、/post/{id}（SSR 详情）、
#       /api/posts（GET 列表 / POST 发文）、/api/stats（JSON 统计 + Top3）、其余 404。
# 展示：capability net,thread、thread_spawn/channel 栅栏与哨兵、Dict 计数、
#       json_decode、跨模块只读传参。
capability net, thread

import views_html
import json_api
import stats_hub

views: Dict[str, int] = {}
ch = channel_new()
ack = channel_new()

def hit_worker() -> None:
    # 后台聚合器：主线程每收一个请求先发路由串进来；SYNC 应答栅栏；QUIT 退出
    while True:
        msg = chan_recv(ch)
        if msg == "QUIT":
            break
        if msg == "SYNC":
            chan_send(ack, "ok")
            continue
        views[msg] = views.get(msg, 0) + 1

def barrier() -> None:
    # 栅栏：等 worker 把此前所有计数落账后再读 views（确定性读）
    chan_send(ch, "SYNC")
    chan_recv(ack)

def reply(conn, status, ctype, body) -> None:
    net_http_write_response(conn, status, ctype, body)

def post_index(posts: List[Tuple[int, str, str]], pid: int) -> int:
    i = 0
    for p in posts:
        if p[0] == pid:
            return i
        i = i + 1
    return -1

def main() -> int:
    posts: List[Tuple[int, str, str]] = []
    posts.append((1, "hello scourge", "A staticly typed, AOT-native language."))
    posts.append((2, "tensors first", "Tensor is a native value, not a library."))
    posts.append((3, "why ahead of time", "One exe, no runtime, run anywhere."))

    worker = thread_spawn("hit_worker")
    lfd = net_bind("127.0.0.1", 18099)
    if lfd < 1:
        print("bind-failed")
        return 1
    print("blog-up port=18099")

    n = 0
    while n < 8:
        c = net_accept(lfd)
        req = net_http_read_request(c)
        if req.is_null():
            net_close(c)
            continue
        route = req.get("path").as_str()
        method = req.get("method").as_str()
        chan_send(ch, route)  # 异步计数（含 API 与 404）
        n = n + 1

        if route == "/" and method == "GET":
            reply(c, 200, "text/html; charset=utf-8", views_html.index_html())
        elif route == "/style.css":
            reply(c, 200, "text/css; charset=utf-8", views_html.css_text())
        elif route.startswith("/post/"):
            pid = -1
            try:
                pid = int(route[6:])
            except:
                pid = -1
            i = post_index(posts, pid)
            if i < 0:
                reply(c, 404, "text/html; charset=utf-8",
                      views_html.not_found_html())
            else:
                barrier()
                v = views.get("/post/" + str(pid), 0)
                reply(c, 200, "text/html; charset=utf-8",
                      views_html.post_html(posts[i][1], posts[i][2], v))
        elif route == "/api/posts":
            if method == "POST":
                try:
                    body = json_decode(req.get("body").as_str())
                    t = body.get("title").as_str()
                    txt = body.get("body").as_str()
                    nid = posts[len(posts) - 1][0] + 1
                    posts.append((nid, t, txt))
                    reply(c, 201, "application/json; charset=utf-8",
                          json_api.post_created_json(nid, t))
                except:
                    reply(c, 400, "application/json; charset=utf-8",
                          json_api.bad_request_json())
            else:
                barrier()
                reply(c, 200, "application/json; charset=utf-8",
                      json_api.posts_json(posts, views))
        elif route == "/api/stats":
            barrier()
            reply(c, 200, "application/json; charset=utf-8",
                  json_api.stats_json(n, views))
        else:
            reply(c, 404, "application/json; charset=utf-8",
                  json_api.not_found_json())
        net_close(c)

    # 收尾：哨兵退出 worker，join 后读终账（确定性），关闭全部句柄
    chan_send(ch, "QUIT")
    thread_join(worker)
    chan_close(ch)
    chan_close(ack)
    net_close(lfd)
    print(f"blog-down requests={n} paths={len(views)} hits={sum(views.values())}")
    print(stats_hub.top_lines(views, 3).trim())
    return 0
