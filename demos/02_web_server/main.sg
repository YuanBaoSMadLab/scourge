# 演示：网络方向 —— 有状态 JSON API 服务
# 在 demo02 基础上加入：服务端请求计数（/stats）、内存 KV 存储（/kv GET/POST）、
# 迭代斐波那契计算（/fib）、查询串解析、按方法分发、完善的错误码。
capability net

def send(conn: int, status: int, body: str) -> None:
    net_http_write_response(conn, status, "application/json; charset=utf-8", body)

def bump(keys: List[str], vals: List[int], key: str) -> None:
    found: int = -1
    i: int = 0
    while i < len(keys):
        if keys[i] == key:
            found = i
        i = i + 1
    if found < 0:
        keys.append(key)
        vals.append(1)
    else:
        vals[found] = vals[found] + 1

def kv_set(keys: List[str], vals: List[str], k: str, v: str) -> None:
    found: int = -1
    i: int = 0
    while i < len(keys):
        if keys[i] == k:
            found = i
        i = i + 1
    if found < 0:
        keys.append(k)
        vals.append(v)
    else:
        vals[found] = v

def kv_get(keys: List[str], vals: List[str], k: str) -> int:
    i: int = 0
    while i < len(keys):
        if keys[i] == k:
            return i
        i = i + 1
    return -1

def fib(n: int) -> int:
    if n <= 0:
        return 0
    a: int = 0
    b: int = 1
    i: int = 0
    while i < n:
        t: int = a + b
        a = b
        b = t
        i = i + 1
    return a

def query_get(q: str, key: str) -> str:
    pairs: List[str] = q.split("&")
    i: int = 0
    while i < len(pairs):
        kv: List[str] = pairs[i].split("=")
        if len(kv) >= 2:
            if kv[0] == key:
                return kv[1]
        i = i + 1
    return ""

def main() -> int:
    l: int = net_bind("127.0.0.1", 18099)
    if l < 1:
        print("bind-failed")
        return 1
    print("server-up port=18099")

    paths: List[str] = []
    path_counts: List[int] = []
    statuses: List[str] = []
    status_counts: List[int] = []
    kvk: List[str] = []
    kvv: List[str] = []
    total: int = 0

    served: int = 0
    while served < 14:
        c: int = net_accept(l)
        req: Json = net_http_read_request(c)
        if req.is_null():
            net_close(c)
            continue
        full: str = req.get("path").as_str()
        method: str = req.get("method").as_str()

        qparts: List[str] = full.split("?")
        route: str = full
        query: str = ""
        if len(qparts) >= 2:
            route = qparts[0]
            query = qparts[1]

        total = total + 1
        bump(paths, path_counts, route)
        status: int = 200

        if route == "/":
            send(c, 200, "{\"service\":\"scourge-demo\",\"version\":\"0.9.10\",\"routes\":[\"/\",\"/health\",\"/echo\",\"/sum\",\"/fib\",\"/stats\",\"/kv\"]}")
        elif route == "/health":
            send(c, 200, "{\"status\":\"ok\",\"requests\":" + format("{}", total) + "}")
        elif route == "/echo":
            send(c, 200, "{\"echo\":\"" + req.get("body").as_str() + "\"}")
        elif route == "/sum":
            try:
                sarr: Json = json_decode(req.get("body").as_str())
                ssum: float = 0.0
                sk: int = 0
                while sk < sarr.len():
                    ssum = ssum + sarr.at(sk).as_float()
                    sk = sk + 1
                send(c, 200, "{\"count\":" + format("{}", sarr.len()) + ",\"sum\":" + format("{}", ssum) + "}")
            except:
                status = 400
                send(c, 400, "{\"error\":\"bad-json-array\"}")
        elif route == "/fib":
            try:
                fbody: Json = json_decode(req.get("body").as_str())
                fn: int = fbody.get("n").as_int()
                if fn < 0:
                    fn = 0
                if fn > 40:
                    fn = 40
                send(c, 200, "{\"n\":" + format("{}", fn) + ",\"fib\":" + format("{}", fib(fn)) + "}")
            except:
                status = 400
                send(c, 400, "{\"error\":\"bad-json-need-n\"}")
        elif route == "/stats":
            sb: str = "{\"total\":" + format("{}", total) + ",\"by_path\":{"
            sp: int = 0
            while sp < len(paths):
                if sp > 0:
                    sb = sb + ","
                sb = sb + "\"" + paths[sp] + "\":" + format("{}", path_counts[sp])
                sp = sp + 1
            sb = sb + "},\"by_status\":{"
            sq: int = 0
            while sq < len(statuses):
                if sq > 0:
                    sb = sb + ","
                sb = sb + "\"" + statuses[sq] + "\":" + format("{}", status_counts[sq])
                sq = sq + 1
            sb = sb + "}}"
            send(c, 200, sb)
        elif route == "/kv":
            if method == "POST":
                try:
                    pbody: Json = json_decode(req.get("body").as_str())
                    pkey: str = pbody.get("key").as_str()
                    pval: str = pbody.get("value").as_str()
                    kv_set(kvk, kvv, pkey, pval)
                    send(c, 200, "{\"ok\":true,\"key\":\"" + pkey + "\",\"size\":" + format("{}", len(kvk)) + "}")
                except:
                    status = 400
                    send(c, 400, "{\"error\":\"bad-json-need-key-value\"}")
            else:
                gkey: str = query_get(query, "key")
                gidx: int = kv_get(kvk, kvv, gkey)
                if gidx >= 0:
                    send(c, 200, "{\"key\":\"" + gkey + "\",\"value\":\"" + kvv[gidx] + "\"}")
                else:
                    status = 404
                    send(c, 404, "{\"error\":\"no-such-key\"}")
        else:
            status = 404
            send(c, 404, "{\"error\":\"not-found\"}")

        bump(statuses, status_counts, format("{}", status))
        net_close(c)
        served = served + 1

    net_close(l)
    print("server-down served", served, "total", total)
    return 0
