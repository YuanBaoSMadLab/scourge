# main.sg — 05 棋盘非线性分类 · 装配入口
# 流程：model.new_param 随机初始化（seed=7 可复现）→ train.run_epoch 逐
# epoch 全批训练 → 逐点预测表 + 总体/分类别准确率。
# 职责边界：本文件只做 epoch 循环编排与评估报告；数据在 dataset、
# 模型在 model、单 epoch 训练步在 train。
# 展示：std.autodiff/nn 全套训练闭环（经 model/train 模块化）、
#       List 切片分段 Adam、f-string 评估表。
import dataset
import model
import train

def main() -> int:
    seed(7)
    nhid = 16
    W1: List[float] = model.new_param(2 * nhid, 1.2)
    b1: List[float] = model.new_param(nhid, 0.3)
    W2: List[float] = model.new_param(nhid, 1.2)
    b2: List[float] = [0.0]
    mW1 = model.zeros(2 * nhid)
    vW1 = model.zeros(2 * nhid)
    mb1 = model.zeros(nhid)
    vb1 = model.zeros(nhid)
    mW2 = model.zeros(nhid)
    vW2 = model.zeros(nhid)
    mb2 = model.zeros(1)
    vb2 = model.zeros(1)

    lr = 0.05
    epochs = 6000
    t = 0
    e = 0
    while e < epochs:
        r = train.run_epoch(W1, b1, W2, b2, mW1, vW1, mb1, vb1, mW2, vW2, mb2, vb2, lr, t, nhid)
        t = r[0]
        avg = r[1]
        if e == 0 or e == 3000 or e == epochs - 1:
            print("epoch", e, "loss", avg)
        e = e + 1

    # 评估：逐点预测表 + 总体/分类别准确率
    print("--- checkerboard evaluation (16 points) ---")
    correct = 0
    c0t = 0
    c0c = 0
    c1t = 0
    c1c = 0
    s = 0
    nsamp = dataset.n_samples()
    while s < nsamp:
        pred = model.predict(W1, b1, W2, b2, nhid, dataset.x0_at(s), dataset.x1_at(s))
        cls = 1 if pred >= 0.5 else 0
        yt = dataset.label_at(s)
        ok = 1 if cls == yt else 0
        correct = correct + ok
        if yt == 0:
            c0t = c0t + 1
            c0c = c0c + ok
        else:
            c1t = c1t + 1
            c1c = c1c + ok
        mark = "ok " if ok == 1 else "MISS"
        print(f"in {dataset.x0_at(s):+5.1f} {dataset.x1_at(s):+5.1f}  pred {pred:.3f}  class {cls}  target {yt}  {mark}")
        s = s + 1
    print(f"accuracy {correct} / {nsamp}")
    print(f"class0 {c0c} / {c0t}   class1 {c1c} / {c1t}")
    return 0
