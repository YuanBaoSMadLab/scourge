# main.sg — 01 代码库度量 CLI · 装配入口
# 用法：main.exe [--path=目录] [--top=N]（缺省扫当前目录、展示前 5）。
# 职责边界：只做 CLI 解析与三层数据流编排——scan.sg 采集、stats.sg 聚合、
# report.sg 呈现；本文件不含任何统计或格式化逻辑。
# 展示：args()、跨模块 import 协作、内建统计、Dict 聚合、write_text 落盘。
capability io, env

import scan
import stats
import report

def main() -> int:
    # CLI 解析：args() 含程序名，仅消费 --path= / --top= 旗标
    path = "."
    top = 5
    for a in args():
        if a.startswith("--path="):
            path = a[7:]
        elif a.startswith("--top="):
            top = int(a[6:])

    # 采集 → 汇总总量（词/字节跨文件累加，行数留给内建统计）
    recs = scan.measure_dir(path)
    if len(recs) == 0:
        print(f"no .sg/.md/.txt files under '{path}'")
        return 1
    total_words = 0
    total_bytes = 0
    lines_only: List[int] = []
    for r in recs:
        total_words = total_words + r[2]
        total_bytes = total_bytes + r[3]
        lines_only.append(r[1])

    print(f"== top {top} files by lines ({path}) ==")
    print(report.top_table(recs, top))

    nf = len(recs)
    print("== summary ==")
    print(f"files {nf}  total_lines {sum(lines_only)}  total_words {total_words}  total_bytes {total_bytes}")
    print(f"mean {mean(lines_only):.1f}  median {median(lines_only):.1f}  std {std(lines_only):.2f}  min {min(lines_only)}  max {max(lines_only)}")

    ext_files = stats.ext_file_counts(recs)
    ext_lines = stats.ext_line_counts(recs)
    print("== by extension ==")
    for it in ext_files.items():
        n = it[1]
        print(f"{it[0]:<8} files {n}  lines {ext_lines[it[0]]}  avg {ext_lines[it[0]] / float(n):.1f}")

    hist = stats.histogram(lines_only)
    print(f"== histogram ==   0-9 {hist[0]}   10-49 {hist[1]}   50-99 {hist[2]}   100+ {hist[3]}")

    write_text(path + "/metrics-report.md",
               report.markdown_report(path, recs, total_words, total_bytes))
    print(f"report -> {path}/metrics-report.md")
    return 0
