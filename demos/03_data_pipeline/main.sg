# main.sg — 03 销售流水 ETL · 装配入口
# 流程：读 data/sales.json（数据外置）→ clean.sg 清洗校验 → aggregate.sg
# 两维聚合报表 + Z-score 离群检测 → 内建统计（sum/mean/std/median）→
# f-string 表格 + write_text 落 Markdown 报告与 JSON 摘要。
# 职责边界：本文件只做编排与落盘，清洗/聚合/报表逻辑在 clean/aggregate。
# 展示：json_decode、类型守卫、Dict.get 累加、定宽键降序、三引号报告模板。
capability io

import clean
import aggregate

def main() -> int:
    raw = read_text("data/sales.json")
    recs = clean.clean_all(raw)
    n = len(recs)
    dropped = 16 - n  # 原始条数固定 16（见 data/sales.json）
    if n == 0:
        print("no valid records")
        return 1

    # 全局标量统计（内建直接作用于金额列）
    amts: List[float] = []
    for r in recs:
        amts.append(r[2])
    grand = sum(amts)
    gmean = mean(amts)
    gstd = std(amts)

    print(f"== by category (kept {n}, dropped {dropped}, revenue {grand:.1f}) ==")
    print(aggregate.cat_console(recs, grand))
    print(aggregate.region_console(recs))

    print("== global ==")
    print(f"orders {n}  revenue {grand:.1f}  mean {gmean:.2f}  std {gstd:.2f}  median {median(amts):.2f}  avg_order {grand / float(n):.2f}")
    print("== outliers (z > 1.5) ==")
    ol = aggregate.outlier_console(recs, gmean, gstd)
    print(ol[0].trim())
    print(f"outlier_count {ol[1]}")

    # 落盘：Markdown 报告 + JSON 摘要（类别维度再聚一次取表与头部类别）
    md = aggregate.cat_markdown(recs, grand)
    write_text("sales-report.md", f"""# sales pipeline report

- records: kept {n}, dropped {dropped}
- revenue: total {grand:.1f}, mean order {gmean:.2f}, std {gstd:.2f}, median {median(amts):.2f}
- top category: {md[1]} ({md[2]:.1f}, share {100.0 * md[2] / grand:.1f}%)
- outliers (z > 1.5): {ol[1]}

| cat | n | revenue | mean | share |
|---|---|---|---|---|
{md[0]}""")
    jparts: List[str] = []
    rev: Dict[str, float] = {}
    cnt: Dict[str, int] = {}
    agg_r: Dict[str, float] = {}
    agg_q: Dict[str, int] = {}
    agg_c: Dict[str, int] = {}
    agg_s: Dict[str, float] = {}
    agg_mn: Dict[str, float] = {}
    agg_mx: Dict[str, float] = {}
    for r in recs:
        aggregate.accum(agg_r, agg_q, agg_c, agg_s, agg_mn, agg_mx, r[0], r[2], r[3])
    for it in agg_c.items():
        c = it[0]
        m = agg_r[c] / float(it[1])
        jparts.append(f'{{"cat":"{c}","n":{it[1]},"revenue":{agg_r[c]:.1f},"avg":{m:.2f}}}')
    write_text("sales-summary.json", "[" + ",".join(jparts) + "]")
    print("report -> sales-report.md / sales-summary.json")
    return 0
