# main.sg — 04 sin(x) 回归 · 装配入口（GUI 实时训练窗）
# 完整实验流程：model.new_param 随机初始化（seed 可复现）→ train.epoch 逐
# epoch 小批训练 → gui_poll 驱动消息泵并实时刷新 loss（点 X 提前中止，
# 训练完自动 gui_close 退出，便于脚本验证）→ 训练/验证 RMSE → 密集网格
# 平均/最大绝对误差。
# 职责边界：本文件只做 GUI 编排与评估报告；数据在 dataset、模型在 model、
# 单 epoch 训练步在 train。
# 展示：capability gui、跨模块训练闭环（可变参数原地更新）、List 切片
#       分段 Adam、gui_window/label/poll/set_text/close。
# 注意：gui 域仅 AOT/Windows 可跑（VM 运行到 gui_* 即固定 panic，双模契约）。
capability gui

import dataset
import model
import train

def main() -> int:
    seed(42)
    nhid = 32
    W1: List[float] = model.new_param(nhid, 1.2)
    b1: List[float] = model.new_param(nhid, 0.3)
    W2: List[float] = model.new_param(nhid, 1.2)
    b2: List[float] = [0.0]
    mW1 = model.zeros(nhid)
    vW1 = model.zeros(nhid)
    mb1 = model.zeros(nhid)
    vb1 = model.zeros(nhid)
    mW2 = model.zeros(nhid)
    vW2 = model.zeros(nhid)
    mb2 = model.zeros(1)
    vb2 = model.zeros(1)

    win = gui_window("Scourge - sin(x) regression", 460, 170)
    lab = gui_label(win, "training...", 16, 14, 420, 24)
    stat = gui_label(win, "dataset: 40 pts (20 train / 20 val), MLP 1-32-1", 16, 46, 420, 24)

    lr = 0.005
    epochs = 16000
    t = 0
    e = 0
    aborted = False
    while e < epochs:
        r = train.run_epoch(W1, b1, W2, b2, mW1, vW1, mb1, vb1, mW2, vW2, mb2, vb2, lr, t, nhid)
        t = r[0]
        avg = r[1]
        if e % 250 == 0 or e == epochs - 1:
            ev = gui_poll(win)  # 驱动消息泵，X 关窗 → 提前中止
            if ev.get("tag", "") == "close":
                aborted = True
                break
            gui_set_text(lab, f"epoch {e}/{epochs}   loss {avg:.4f}")
        if e == 0 or e == 8000 or e == epochs - 1:
            print("epoch", e, "train_loss", avg)
        e = e + 1

    gui_close(win)
    if aborted:
        print("aborted at epoch", e)
        return 1

    # 训练/验证 RMSE（误差接近 → 泛化良好）；奇偶归属由 dataset 给出
    sse_tr = 0.0
    sse_va = 0.0
    s = 0
    nsamp = dataset.n_samples()
    while s < nsamp:
        d = model.predict(W1, b1, W2, b2, dataset.x_at(s)) - dataset.y_at(s)
        if dataset.is_train(s) == 1:
            sse_tr = sse_tr + d * d
        else:
            sse_va = sse_va + d * d
        s = s + 1
    rmse_tr = sqrt(sse_tr / float(dataset.n_train()))
    rmse_va = sqrt(sse_va / float(dataset.n_val()))
    print(f"train_rmse {rmse_tr:.4f}   val_rmse {rmse_va:.4f}")

    # 密集网格 [-1,1]，真值经 dataset.truth（与样本标签同一定义）
    grid = 21
    mae = 0.0
    mxe = 0.0
    gi = 0
    while gi < grid:
        gx = -1.0 + 2.0 * float(gi) / float(grid - 1)
        gt = dataset.truth(gx)
        ae = model.predict(W1, b1, W2, b2, gx) - gt
        if ae < 0.0:
            ae = -ae
        mae = mae + ae
        if ae > mxe:
            mxe = ae
        if gi % 5 == 0:
            print(f"x {gx:+.2f} true {gt:.3f} pred {model.predict(W1, b1, W2, b2, gx):+.3f} abserr {ae:.3f}")
        gi = gi + 1
    print(f"grid_mae {mae / float(grid):.4f}   grid_max_abserr {mxe:.4f}")
    return 0
