# Option 基础探针（0.9.9 批3）：Option[T] ≡ Result[T,None] 同构。
# None 即空选项；裸标量赋值自动包装（T→Option[T]）；ok() 即 Some 构造；
# is_some/unwrap/unwrap_or 与 Result 消费同形。断言式输出保证确定性。
def check(x: Option[int]) -> int:
    if x.is_some():
        return x.unwrap(-1)
    return -100

def maybe_str(flg: bool) -> Option[str]:
    if flg:
        return "yes"
    return None

def main() -> int:
    a: Option[int] = None
    b: Option[int] = 42
    c: Option[int] = ok(7)
    print(a.is_some())                       # False
    print(b.is_some())                       # True
    print(c.is_some())                       # True
    print(a.unwrap(-1))                      # -1（空选项取缺省）
    print(b.unwrap(-1))                      # 42
    print(c.unwrap(-1))                      # 7
    print(b.unwrap_or(0))                    # 42
    print(a.unwrap_or(0))                    # 0
    print(check(a))                          # -100
    print(check(b))                          # 42
    f: Option[float] = 2.5
    print(f.unwrap(0.0))                     # 2.5
    n: Option[float] = None
    print(n.unwrap(9.5))                     # 9.5
    s: Option[str] = maybe_str(True)
    print(s.is_some())                       # True
    print(s.unwrap("dft"))                   # yes
    print(maybe_str(False).is_some())        # False
    print(maybe_str(False).unwrap("empty"))  # empty
    bb: Option[bool] = True
    print(bb.unwrap(False))                  # True
    nb: Option[bool] = None
    print(nb.is_some())                      # False
    return 0
