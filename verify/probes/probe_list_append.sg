# probe_list_append.sg - 0.9.8 List.append scalar domains probe (dual mode)
# Expect (run and build output byte identical):
#   [3, 1, 2, 4] / [2.5, 9.5] / [True, False] / ["a", "b"]
#   [7] / [1.5] / [True] / [7, 9, 8, 0] x2 (alias shared)
def main() -> int:
    xs: List[int] = [3, 1, 2]
    xs.append(4)
    print(xs)
    fs: List[float] = [2.5]
    fs.append(9.5)
    print(fs)
    # int argument into float list: single widening rule (same as 'in')
    fs2: List[float] = [1.0]
    fs2.append(2)
    print(fs2)
    bs: List[bool] = [True]
    bs.append(False)
    print(bs)
    ss: List[str] = ["a"]
    ss.append("b")
    print(ss)
    # empty list literal: first append fixes element domain
    e1: List[int] = []
    e1.append(7)
    print(e1)
    e2: List[float] = []
    e2.append(1.5)
    print(e2)
    e3: List[bool] = []
    e3.append(True)
    print(e3)
    # alias visibility: shared handle, all names observe appended values
    e1.append(9)
    e1.append(8)
    alias: List[int] = e1
    alias.append(0)
    print(alias)
    print(e1)
    return 0
