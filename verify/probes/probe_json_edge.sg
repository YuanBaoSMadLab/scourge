def main() -> int:
    esc: Json = json_decode("\"line1\\nline2\\tA\\u0041\\u4e2d\\u6587 quote:\\\" back:\\\\/\\b\\f\\r\"")
    print(esc.as_str())
    print(esc.dump())
    neg: Json = json_decode("[ -42, 0, 9007199254740993, 1.5e3, -2.5e-3, 1e2 ]")
    print(neg.at(0).as_int())
    print(neg.at(1).as_int())
    print(neg.at(2).as_int())
    print(neg.at(3).as_float())
    print(neg.at(4).as_float())
    print(neg.at(5).is_float())
    print(neg.at(5).dump())
    e: Json = json_decode("{}")
    print(e.is_obj())
    print(e.len())
    print(e.dump())
    a: Json = json_decode("[]")
    print(a.len())
    print(a.dump())
    dup: Json = json_decode("{\"k\": 1, \"k\": 2}")
    print(dup.get("k").as_int())
    print(dup.dump())
    print(esc)
    deep: Json = json_decode("[[[[\"deep\"]]]]")
    print(deep.at(0).at(0).at(0).at(0).as_str())
    num: Json = json_decode("42")
    print(num.is_int())
    print(num.as_int())
    print(num.dump())
    return 0
