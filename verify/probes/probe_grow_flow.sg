# str 自拼接原地扩容：控制流与调用交互（跨块汇合 / 双发射点交替 /
# 形参别名登记 / 返回值别名链）。全局复合赋值在函数内被 VM 拒绝（E2003，
# 既有分歧，另行记录），此处全部使用双模合法构造。
def h(x: str) -> str:
    x += "q"
    return x

def idr(x: str) -> str:
    return x

def main() -> int:
    # 1 双累积器循环（各发射点独立登记）
    a = ""
    b = ""
    for i in range(100):
        a += "A"
        b += "B"
    print(len(a), len(b), a[0], b[0])
    # 2 同变量双发射点（if/else 交替）——登记表失配走慢路径，内容恒等
    c = ""
    for i in range(50):
        if i % 2 == 0:
            c += "E"
        else:
            c += "O"
    print(len(c), c[0], c[1])
    # 3 局部 += 且 RHS 含调用：形参绑定登记 → 调用后原地路径降级
    s = "L"
    for i in range(3):
        s += h(s)
    print(s)
    # 4 赋值形态 s = s + h(s)：特化 + 形参 mark → 与 VM 值快照语义一致
    s = "S"
    s = s + h(s)
    print(s)
    # 5 返回别名链：t = idr(s) 后 s += —— return 的缓冲经存槽登记，t 不变
    w = "W"
    t = idr(w)
    w += "z"
    print(t, w)
    # 6 丢弃返回值（不存槽）后再累积：登记表失配仅慢路径，内容恒等
    h("d")
    u = "U"
    for i in range(3):
        u += "u"
    print(u)
    return 0
