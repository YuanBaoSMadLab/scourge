# ============================================================================
#  t02_vars.sg — 变量与赋值：直接赋值、注解赋值、重复赋值、增强赋值
#  对应章节：第4章 变量与赋值
# ============================================================================

def main() -> int:
    # 直接赋值：无 var/let 关键字，类型自动推断
    x = 42
    pi = 3.14
    name = "scourge"
    flag = True

    # 带注解的赋值：注解与实际类型不符编译期报 E2001
    n: int = 10
    ratio: float = 0.5
    label: str = "v1"

    # 重复赋值：类型必须一致
    x = x + 1

    # 增强赋值（标量）
    n += 5
    n -= 1
    n *= 3
    ratio /= 2.0

    # 字符串增强赋值
    label += "-beta"

    # 声明式注解：必须带初值——无初值声明（count: int）会使 run/build
    # 双双段错误（已知缺口 Q1，probe_seg_a1.sg 为最小复现），故写初值。
    count: int = 0

    # 数值中括号字面量恒为张量（Tensor[int, (3)]），
    # 不能赋给 List[int]（E2001）；List 装非数值元素。
    xs: List[str] = ["a", "b", "c"]

    print(x)
    print(n)
    print(ratio)
    print(label)
    print(count)
    print(xs)
    print(len(xs))
    print(xs[0], xs[2])

    # 张量与标量的增强赋值当前不支持（t *= 2.0 报错），须写展开形式
    t = [[1.0, 2.0], [3.0, 4.0]]
    t = t * 2.0
    print(t)

    return 0

# 期望输出（scourge 0.9.1 实测）：
# 43
# 42
# 0.25
# v1-beta
# 0
# ["a", "b", "c"]
# 3
# a c
# Tensor(2, 2) [[2.0, 4.0], [6.0, 8.0]]
