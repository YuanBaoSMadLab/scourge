# 0.9.9 切片探针：s[a:b] str/List 双型边界（正/负/缺省/越界/空区间/嵌套）
# 语义对齐 Python：负下标 +len、越界钳 len、b<a 收敛空串/空列表。
def main() -> int:
    s = "hello world"
    print(s[0:5] == "hello")
    print(s[6:11] == "world")
    print(s[:5] == "hello")
    print(s[6:] == "world")
    print(s[:] == "hello world")
    print(s[-5:] == "world")
    print(s[:-6] == "hello")
    print(s[-4:-1] == "orl")
    print(s[3:3] == "")
    print(s[8:3] == "")
    print(s[5:100] == " world")
    print(s[-100:3] == "hel")
    print(s[0:5][1:3] == "el")
    print(len(s[6:]) == 5)
    l: List[int] = [1, 2, 3, 4, 5]
    print(l[1:3])
    print(l[:2])
    print(l[3:])
    print(l[-2:])
    print(l[2:2])
    print(l[4:100])
    print(l[-100:2])
    ls: List[str] = ["a", "b", "c", "d"]
    print(ls[1:3])
    return 0
