# gpu_sum_tr.sg — GPU 覆盖集探针：sum / transpose（f64 GPU；int CPU；链式组合）
def main() -> int:
    a = [[1.5, -2.25, 3.125], [0.75, -1.5, 2.0]]
    print("sum2d=" + str(sum(a)))
    print("sum1d=" + str(sum(a[0])))
    print("tr23=" + str(transpose(a)))
    print("tr_rt=" + str(transpose(transpose(a))))
    print("sum_tr=" + str(sum(transpose(a))))
    ti = [[1, 2, 3], [4, 5, 6]]
    print("tr_int=" + str(transpose(ti)))
    print("sum_i=" + str(sum(ti)))
    err = [[0.5, -1.0], [2.0, 0.25]]
    print("mse=" + str(sum(err * err) / 4.0))
    # 与 matmul/逐元素混合（attention_softmax 风格片段）
    q = [[1.0, 0.0], [0.0, 1.0], [0.5, 0.5]]
    k = [[1.0, 0.0], [0.0, 1.0], [0.5, 0.5]]
    scores = q @ transpose(k) / 1.4142135623730951
    print("attn_scores=" + str(scores))
    return 0
