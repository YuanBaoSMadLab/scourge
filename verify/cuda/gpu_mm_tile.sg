# gpu_mm_tile.sg - matmul shared-memory tiling 32x32 boundary probe:
# tile tail crossing (31/32/33), rect 100x7 @ 7x3, k=1 single inner dim,
# k=64 full two k-tiles, plus 33x33@33x33 chain (k=33 non-multiple).
# Big matrices built as outer products of small 1D literals (reshape + @);
# elements cycle through +/-/zero values.
def main() -> int:
    v31 = [-0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25]
    v32 = [-0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0]
    v33 = [-0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25]

    l31 = reshape(v31, 31, 1)
    r31 = reshape(v31, 1, 31)
    m31 = l31 @ r31
    l32 = reshape(v32, 32, 1)
    r32 = reshape(v32, 1, 32)
    m32 = l32 @ r32
    l33 = reshape(v33, 33, 1)
    r33 = reshape(v33, 1, 33)
    m33 = l33 @ r33

    print("mm31=" + str(m31[0, 0]) + " " + str(m31[30, 30]))
    print("mm32=" + str(m32[0, 0]) + " " + str(m32[31, 31]))
    print("mm33=" + str(m33[0, 0]) + " " + str(m33[32, 32]))
    print("sum31=" + str(sum(m31)))
    print("sum32=" + str(sum(m32)))
    print("sum33=" + str(sum(m33)))
    c3333 = m33 @ m33
    print("mm3333=" + str(c3333[0, 0]) + " " + str(sum(c3333)))

    v100 = [-0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5]
    v7 = [0.5, -1.5, 2.5, 3.5, -0.5, 4.5, 1.5]
    v21 = [0.5, -1.5, 2.5, 3.5, -0.5, 4.5, 1.5, 0.5, -1.5, 2.5, 3.5, -0.5, 4.5, 1.5, 0.5, -1.5, 2.5, 3.5, -0.5, 4.5, 1.5]
    a100x7 = reshape(v100, 100, 1) @ reshape(v7, 1, 7)
    b7x3 = reshape(v21, 7, 3)
    c100x3 = a100x7 @ b7x3
    print("mm100=" + str(c100x3[0, 0]) + " " + str(c100x3[99, 2]))
    print("sum100=" + str(sum(c100x3)))

    v3 = [1.0, -2.0, 3.0]
    v4 = [0.5, 1.5, -2.5, 2.0]
    k1 = reshape(v3, 3, 1) @ reshape(v4, 1, 4)
    print("mmk1=" + str(k1))
    print("sumk1=" + str(sum(k1)))

    v4b = [0.25, -0.5, 1.0, 2.0]
    v64 = [-0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, -0.75]
    v2 = [1.5, -0.5]
    a464 = reshape(v4b, 4, 1) @ reshape(v64, 1, 64)
    b642 = reshape(v64, 64, 1) @ reshape(v2, 1, 2)
    k64 = a464 @ b642
    print("mmk64=" + str(k64[0, 0]) + " " + str(k64[3, 1]))
    print("sumk64=" + str(sum(k64)))
    return 0
